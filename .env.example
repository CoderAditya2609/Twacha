# Choose one: openai, gemini, nvidia
AI_PROVIDER=openai
AI_API_KEY=replace_with_your_server_side_key
# Examples: gpt-5-mini (openai), gemini-3.8-flash (gemini), meta/llama-3.3-70b-instruct (nvidia)
AI_MODEL=gpt-5-mini
# Optional: override the compatible API URL (NVIDIA defaults to its API URL)
AI_BASE_URL=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_EMAILS=your-email@example.com
