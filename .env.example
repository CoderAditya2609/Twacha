# Admin emails (comma-separated list for dashboard access)
ADMIN_EMAILS=

# Server-side AI provider configuration
# Supported providers: gemini, openai, nvidia
AI_PROVIDER=gemini

# NOTE: AI_MODEL must be a vision-capable model for skin photo analysis
# Examples:
# For Gemini: gemini-3.8-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
# For OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# For Nvidia: meta/llama-3.2-11b-vision-instruct
AI_MODEL=gemini-2.5-flash

# API key for the chosen AI provider
AI_API_KEY=
GEMINI_API_KEY=

# Optional base URL for OpenAI or Nvidia endpoints
AI_BASE_URL=

# Supabase configuration (optional / client & admin access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=